<link rel="stylesheet" href="/assets/css/feed.css" />

<div id="feed" class="container flex col gap-24">
    <div class="header flex col gap-4 text-center">
        <!-- prettier-ignore -->
        <h1 class="text-32 text-regular no-margin">
            <span class="text-accent">osu!</span><span class="text-bright">feed</span>
        </h1>
    </div>
    <div class="flex row gap-16 align-center flex-wrap">
        <div id="filters" class="flex row gap-8 flex-wrap">
            <button id="editFilters" class="btn small">
                <span class="symbol filled">filter_alt</span>
                <span class="label">Edit filters...</span>
            </button>
        </div>
    </div>
    <div class="flex col gap-8">
        <div class="statusCont flex row gap-16">
            <div id="statusCont" class="flex row gap-8 flex-grow align-center">
                <span id="statusSymbol" class="symbol"></span>
                <span id="statusText" class="text-15 text-medium"></span>
            </div>
            <button id="clearFeed" class="btn small text secondary">
                <span class="symbol">mop</span>
                <span class="label">Clear feed</span>
            </button>
        </div>
        <div id="scores" class="flex col gap-8">
            <div class="empty flex col gap-16 align-center text-center" style="padding: 32px 8px">
                <span class="symbol text-48 text-muted">cell_tower</span>
                <p class="text-18 text-medium text-muted">Waiting for new scores...</p>
            </div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/assets/js/feed.js"></script>
