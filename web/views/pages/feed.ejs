<div id="feed" class="container flex col gap-24" style="max-width: 1200px">
    <div class="header flex col gap-4 text-center">
        <!-- prettier-ignore -->
        <h1 class="text-32 text-regular no-margin">
            <span class="text-accent">osu!</span><span class="text-bright">feed</span>
        </h1>
        <p class="text-muted text-14">A real-time feed of osu! score submissions.</p>
    </div>
    <div class="flex row gap-16 align-center flex-wrap">
        <div id="filters" class="flex-grow">
            <button id="addFilter" class="btn small">
                <span class="symbol filled">filter_alt</span>
                <span class="label">Add filter...</span>
            </button>
        </div>
    </div>
    <div class="flex col gap-8">
        <div class="statusCont flex row gap-16">
            <div id="statusCont" class="flex row gap-8 flex-grow align-center">
                <span id="statusSymbol" class="symbol"></span>
                <span id="statusText" class="text-15 text-medium"></span>
            </div>
            <button id="clearFeed" class="btn small outline danger">
                <span class="symbol">close</span>
                <span class="label">Clear feed</span>
            </button>
        </div>
        <div id="scores" class="flex col gap-8"></div>
    </div>
</div>

<style>
    @keyframes scoreFadeIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #scores .entry {
        color: inherit;
        border: 1px solid var(--c-border-default);
        border-radius: 16px;
        overflow: hidden;
        animation: scoreFadeIn 0.2s ease-out forwards;
        transition: 0.1s ease-in-out;
    }
    #scores .entry:hover {
        text-decoration: none;
        border-color: var(--c-action-primary);
        box-shadow: 0px 0px 0px 2px var(--c-action-primary);
    }

    #scores .entry .pill {
        --bg: #999;
        --fg: black;
        padding: 2px 6px;
        font-size: 12px;
        font-weight: 700;
        background: var(--bg);
        color: var(--fg);
        border-radius: 100px;
    }
    #scores .entry .pill .symbol {
        font-size: 18px;
        margin: -16px 0;
    }

    #scores .entry .map {
        background: var(--c-bg-subsurface);
        border-bottom: 1px solid var(--c-border-default);
        padding: 8px;
    }
    #scores .entry .map .mode {
        width: 16px;
        height: 16px;
    }
    #scores .entry .map .status.ranked,
    #scores .entry .map .status.approved {
        --bg: hsl(90, 100%, 70%);
    }
    #scores .entry .map .status.loved {
        --bg: hsl(340, 100%, 70%);
    }
    #scores .entry .map .status.qualified {
        --bg: hsl(200, 100%, 70%);
    }
    #scores .entry .map .status.pending {
        --bg: hsl(30, 100%, 70%);
    }

    #scores .entry .score {
        padding: 8px;
    }
    #scores .entry .score .avatar {
        width: 36px;
        height: 36px;
        border-radius: 12px;
    }
    #scores .entry .score .flag {
        height: 14px;
        border-radius: 2px;
    }
</style>

<script src="/socket.io/socket.io.js"></script>
<script src="/assets/js/feed.js"></script>
